# ─────────────────────────────────────────────────────────────
# RailwayOne Pro — example environment (copy to .env and edit)
# DEMO ONLY. Never put real payment credentials here.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# PostgreSQL connection (docker compose exposes Postgres on 5432)
DATABASE_URL=postgresql://railway:railway_dev_pw@localhost:5432/railwayone?schema=public

# Server-side pepper used to HMAC session tokens before storing them.
# Generate your own:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-of-at-least-32-chars

# Session lifetime in hours
SESSION_TTL_HOURS=72

# Allowed browser origin(s) for CORS, comma-separated (dev Vite server by default)
CORS_ORIGINS=http://localhost:5173

# Set to true when serving over HTTPS so cookies get the Secure flag
COOKIE_SECURE=false

# Seed credentials for the demo accounts created by `npm run db:seed`
SEED_DEMO_EMAIL=demo@railwayone.dev
SEED_DEMO_PASSWORD=Demo@12345
SEED_ADMIN_EMAIL=admin@railwayone.dev
SEED_ADMIN_PASSWORD=Admin@12345

# Number of reverse-proxy hops to trust for client IPs (0 = none, 1 = one proxy such as nginx)
TRUST_PROXY=1

# Who may embed the app in an iframe (CSP frame-ancestors). "'self'" by default; use "*" only for preview tooling.
FRAME_ANCESTORS='self'

# Rate limits (requests per 15 minutes per IP)
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30
PAYMENT_RATE_LIMIT_MAX=60

# Optional: absolute/relative path to the built web app that Express should serve (defaults to ../web/dist)
# WEB_DIST_DIR=../web/dist
